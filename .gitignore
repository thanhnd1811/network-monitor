# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.iml

# Android build outputs (we generate APK in CI, never local)
android-src/.gradle/
android-src/build/
android-src/app/build/
android-src/local.properties
android-src/app/url.properties

# Local web data copy (only real data/ is committed by the monitor workflow)
web/data/

# Local working files
*.tmp
out/

# Local-monitor build artifacts
local-monitor/build/
local-monitor/dist/
local-monitor/*.spec
local-monitor/config.json
local-monitor/probe.log

# Don't commit binary EXE in source repo (it's distributed via Releases instead)
local-monitor/ftu-netmon-probe.exe
local-monitor/*.zip

# Bundled deployment ZIP (built locally, distribute via copy or Releases)
ftu-netmon-local.zip
